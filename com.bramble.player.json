{
  "app-id": "com.bramble.player",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.7",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node22"
  ],
  "command": "bramble",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home:ro",
    "--filesystem=media:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node22/bin"
  },
  "modules": [
    {
      "name": "libsndfile",
      "buildsystem": "simple",
      "build-commands": [
        "echo 'Flatpak build for libsndfile - install from system'"
      ]
    },
    {
      "name": "bramble",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "QMAKE": "qmake6"
        }
      },
      "build-commands": [
        "qmake6 PREFIX=/app Bramble.pro",
        "make -j$(nproc)",
        "install -Dm755 Bramble /app/bin/bramble",
        "install -Dm644 Bramble.desktop /app/share/applications/com.bramble.player.desktop",
        "install -Dm644 icon.png /app/share/icons/hicolor/256x256/apps/com.bramble.player.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
